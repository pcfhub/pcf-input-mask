<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Japanese (ja-JP, LCID 1041).

    Keep the key set identical to InputMask.1033.resx. A key missing here does
    not fall back to English — it renders as the key name, and only for users in
    this language, so nobody who reads English ever sees it. `npm run check`
    compares the two.

    Input Mask and Type into a pattern — phone numbers, postal codes, IDs — and the column keeps its shape. are filled by `npm run setup` with the English
    title and tagline you gave it, because the template cannot know them. They
    are the two values in this file worth translating by hand.
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
