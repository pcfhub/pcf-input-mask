  </resheader>

  <data name="InputMask_Name" xml:space="preserve">
    <value>Input Mask</value>
  </data>
  <data name="InputMask_Desc" xml:space="preserve">
    <value>Eingabe in ein Muster – Telefonnummern, Postleitzahlen, Kennungen –, und die Spalte behält ihre Form.</value>
  </data>
  <data name="value_Name" xml:space="preserve">
    <value>Wert</value>
  </data>
  <data name="value_Desc" xml:space="preserve">
    <value>Die Text- oder Telefonspalte, die dieses Steuerelement maskiert.</value>
  </data>
  <data name="placeholder_Name" xml:space="preserve">
    <value>Platzhalter</value>
  </data>
  <data name="placeholder_Desc" xml:space="preserve">
    <value>Hinweistext, der angezeigt wird, solange das Feld leer ist.</value>
  </data>
  <data name="InputMask_NoAccess" xml:space="preserve">
    <value>Sie haben keinen Zugriff auf diesen Wert.</value>
  </data>
  <data name="mask_Name" xml:space="preserve">
    <value>Maske</value>
  </data>
  <data name="mask_Desc" xml:space="preserve">
    <value>Die Form des Werts: eine Vorlage oder „Benutzerdefiniert“ mit dem Muster unten.</value>
  </data>
  <data name="mask_PhoneUs" xml:space="preserve">
    <value>US-Telefon (999) 999-9999</value>
  </data>
  <data name="mask_Zip" xml:space="preserve">
    <value>ZIP-Code 99999</value>
  </data>
  <data name="mask_Zip4" xml:space="preserve">
    <value>ZIP+4 99999-9999</value>
  </data>
  <data name="mask_PostalCa" xml:space="preserve">
