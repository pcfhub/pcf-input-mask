<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Display names and descriptions for everything declared in
    ControlManifest.Input.xml. PCFHub reads the manifest, so these strings are
    what appear in the component's API reference on the hub as well as in the
    maker's properties pane.

    Copy this file to add a language — InputMask.3082.resx for Spanish, and so
    on — then list it under <resources> in the manifest.
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="type" type="xsd:string" />
              <xsd:attribute name="mimetype" type="xsd:string" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <data name="InputMask_Name" xml:space="preserve">
    <value>Input Mask</value>
  </data>
  <data name="InputMask_Desc" xml:space="preserve">
    <value>Type into a pattern — phone numbers, postal codes, IDs — and the column keeps its shape.</value>
  </data>

  <data name="value_Name" xml:space="preserve">
    <value>Value</value>
  </data>
  <data name="value_Desc" xml:space="preserve">
    <value>The Text or Phone column this control masks.</value>
  </data>

  <data name="placeholder_Name" xml:space="preserve">
    <value>Placeholder</value>
  </data>
  <data name="placeholder_Desc" xml:space="preserve">
    <value>Hint text shown while the field is empty.</value>
  </data>
  <!--
    Runtime strings, read with context.resources.getString(). Anything the user
    can read belongs here rather than as a literal in index.ts or as an input
    property a maker hand-translates per instance.

    Add a language by copying this file — InputMask.3082.resx for Spanish,
    1036 French, 1031 German, 1041 Japanese — with the SAME key set, then
    listing each one under <resources> in the manifest. A key missing from one
    language falls back to the key name in that language only, which nobody
    notices until a customer does.
  -->
  <data name="InputMask_NoAccess" xml:space="preserve">
    <value>You do not have access to this value.</value>
  </data>
  <data name="mask_Name" xml:space="preserve">
    <value>Mask</value>
  </data>
  <data name="mask_Desc" xml:space="preserve">
    <value>The shape the value takes: a preset, or Custom with the pattern below.</value>
  </data>
  <data name="mask_PhoneUs" xml:space="preserve">
    <value>US phone (999) 999-9999</value>
  </data>
  <data name="mask_Zip" xml:space="preserve">
    <value>ZIP code 99999</value>
  </data>
  <data name="mask_Zip4" xml:space="preserve">
    <value>ZIP+4 99999-9999</value>
  </data>
  <data name="mask_PostalCa" xml:space="preserve">
    <value>Canadian postal code A9A 9A9</value>
  </data>
  <data name="mask_Ssn" xml:space="preserve">
    <value>SSN 999-99-9999</value>
  </data>
  <data name="mask_Custom" xml:space="preserve">
    <value>Custom pattern</value>
  </data>
  <data name="pattern_Name" xml:space="preserve">
    <value>Custom pattern</value>
  </data>
  <data name="pattern_Desc" xml:space="preserve">
    <value>Used when Mask is Custom. 9 is a digit, a a letter, A a letter made upper-case, * a letter or digit; \ before a character makes it literal. Example: AA-9999.</value>
  </data>
  <data name="store_Name" xml:space="preserve">
    <value>Store as</value>
  </data>
  <data name="store_Desc" xml:space="preserve">
    <value>Formatted stores what the user sees; Raw stores only the characters typed into the slots.</value>
  </data>
  <data name="store_Formatted" xml:space="preserve">
    <value>Formatted</value>
  </data>
  <data name="store_Raw" xml:space="preserve">
    <value>Raw characters only</value>
  </data>
  <data name="guide_Name" xml:space="preserve">
    <value>Guide</value>
  </data>
  <data name="guide_Desc" xml:space="preserve">
    <value>Show the mask’s shape, such as (___) ___-____, in an empty field while it has focus.</value>
  </data>
  <data name="guide_On" xml:space="preserve">
    <value>On</value>
  </data>
  <data name="guide_Off" xml:space="preserve">
    <value>Off</value>
  </data>
  <data name="isValid_Name" xml:space="preserve">
    <value>Is valid</value>
  </data>
  <data name="isValid_Desc" xml:space="preserve">
    <value>True when the value is empty or fills the mask. For a canvas app to gate its Save on; do not bind it on a model-driven form.</value>
  </data>
  <data name="InputMask_Incomplete" xml:space="preserve">
    <value>Incomplete: {0} of {1} characters.</value>
  </data>
  <data name="InputMask_Lossy" xml:space="preserve">
    <value>The saved value “{0}” does not fit this mask. Editing it will reformat it.</value>
  </data>
  <data name="InputMask_BadPattern" xml:space="preserve">
    <value>This field’s custom pattern is empty or has no 9, a, A or *, so it accepts nothing.</value>
  </data>
</root>
