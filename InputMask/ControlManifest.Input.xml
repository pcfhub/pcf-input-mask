<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <!--
    The version here is what the Power Platform upgrades on, and the release
    workflow refuses to publish a tag that disagrees with it. Bump this in the
    same commit as the tag.
  -->
  <control namespace="PCFHub"
           constructor="InputMask"
           version="0.0.4"
           display-name-key="InputMask_Name"
           description-key="InputMask_Desc"
           control-type="standard">

    <!--
      Leave this disabled unless the control calls a third-party service.

      `enabled="true"` makes the control **premium**, and premium is a cost
      somebody else pays: every end user of an app containing this component
      then needs a Power Apps licence rather than an Office 365 one. Nothing
      fails to build, nothing warns at install, and the person who finds out is
      not the person who typed it — so this is worth confirming with whoever
      owns the control rather than flipping to make a `fetch` work.

      When it is genuinely enabled, list every domain. `<domain>` children are
      declarative and can be listed under `enabled="false"` too, which is the
      schema's own second example; it is the `enabled` attribute alone that
      carries the licensing consequence.

          <external-service-usage enabled="true">
            <domain>tile.example.com</domain>
          </external-service-usage>

      `npm run check` fails on `enabled="true"` with no domain, and warns on
      `enabled="true"` at all.
    -->
    <external-service-usage enabled="false" />

    <!--
      PCFHub generates the component's API reference from this file, at the tag
      of each release.

      It records `display-name-key` and `description-key` *verbatim* — it does
      not read the .resx — so a reader sees the key itself unless something
      changes it. Two ways to get readable text: keep the keys themselves
      readable, or correct them once in the hub's admin panel, where editing a
      property locks that field so later syncs leave it alone.

      The platform still resolves these against the .resx for the maker's
      properties pane, so the keys must exist there either way.
    -->
    <!--
      Text and Phone: the two single-line formats a mask is for. A Phone column
      is where the platform's retired Input Mask control was most often put,
      and a type group is the only way one property binds both. Email and URL
      are left out on purpose — neither has a fixed shape, and an email input
      has no cursor to put back (`setSelectionRange` throws on one).
    -->
    <type-group name="maskable">
      <type>SingleLine.Text</type>
      <type>SingleLine.Phone</type>
    </type-group>

    <property name="value"
              display-name-key="value_Name"
              description-key="value_Desc"
              of-type-group="maskable"
              usage="bound"
              required="true" />

    <!--
      The shape. A preset, or `custom` with `pattern` below. The code decides
      what blank means (the US phone), because a default-value on an optional
      property is applied by some hosts and not by others.
    -->
    <property name="mask"
              display-name-key="mask_Name"
              description-key="mask_Desc"
              of-type="Enum"
              usage="input"
              required="false"
              default-value="phone-us">
      <value name="phone-us" display-name-key="mask_PhoneUs">phone-us</value>
      <value name="zip" display-name-key="mask_Zip">zip</value>
      <value name="zip4" display-name-key="mask_Zip4">zip4</value>
      <value name="postal-ca" display-name-key="mask_PostalCa">postal-ca</value>
      <value name="ssn" display-name-key="mask_Ssn">ssn</value>
      <value name="custom" display-name-key="mask_Custom">custom</value>
    </property>

    <!--
      Read only when `mask` is `custom`: 9 a digit, a a letter, A a letter made
      upper-case, * a letter or digit, \ before a character makes it a literal.
      The modern form designer caps a static input at 100 characters, far more
      than any mask needs.
    -->
    <property name="pattern"
              display-name-key="pattern_Name"
              description-key="pattern_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <!--
      What the column holds. `formatted` is what views, search and exports
      already show; `raw` is the typed characters alone, for an integration
      that wants digits. Either shape already in the column is read.
    -->
    <property name="store"
              display-name-key="store_Name"
              description-key="store_Desc"
              of-type="Enum"
              usage="input"
              required="false"
              default-value="formatted">
      <value name="formatted" display-name-key="store_Formatted">formatted</value>
      <value name="raw" display-name-key="store_Raw">raw</value>
    </property>

    <!--
      The `(___) ___-____` guide in an empty, focused field. An Enum rather
      than a TwoOptions because a TwoOptions cannot default to on.
    -->
    <property name="guide"
              display-name-key="guide_Name"
              description-key="guide_Desc"
              of-type="Enum"
              usage="input"
              required="false"
              default-value="on">
      <value name="on" display-name-key="guide_On">on</value>
      <value name="off" display-name-key="guide_Off">off</value>
    </property>

    <!--
      Whether the value fills the mask — true for a complete value and for an
      empty one, false for a partial one or a stored value the mask cannot
      read without losing part of it. For a canvas app to gate its Save on:
      a form's save cannot be blocked from a control. Do not bind it on a
      model-driven form — binding an output in the classic designer breaks the
      form's save (measured on pcf-code-editor 1.3.0). Outputs are permanent
      API: a formula may bind them.
    -->
    <property name="isValid"
              display-name-key="isValid_Name"
              description-key="isValid_Desc"
              of-type="TwoOptions"
              usage="output" />

    <property name="placeholder"
              display-name-key="placeholder_Name"
              description-key="placeholder_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <resources>
      <code path="index.ts" order="1" />
      <css path="css/InputMask.css" order="1" />
      <!--
        Every language the control ships.

        A .resx that exists on disk but is not listed here is not shipped, and
        nothing warns — the file is simply never packed, and the control runs
        in English for that locale while the repository looks translated.
        `npm run check` catches both that and a key missing from a language.

        Drop the ones you will not maintain. A stale translation is worse than
        an honest fallback to English, and every key added to 1033 is a key
        owed to each file listed here.

        THE ORDER IS DELIBERATE AND 1033 GOES LAST. `pcf-start` picks the .resx
        by manifest order rather than by locale: it reads whichever file is
        listed *last* and ignores the LCID and the browser language entirely.
        The platform itself ignores the order completely — a real app resolves
        from the user's provisioned language — so `npm start` is the only thing
        in the world that reads this order, and it is ordered for it. Listing
        1033 first is the tidier-looking arrangement and it makes `npm start`
        render the whole control in Japanese, which reads as a broken build.

        The consequence to remember: ADD A NEW LANGUAGE ABOVE THIS LINE, not
        below it. Appending a sixth file after 1033 silently moves the harness
        to that language, and the symptom shows up in a `npm start` session
        nobody connects to a manifest edit.
      -->
      <resx path="strings/InputMask.3082.resx" version="1.0.0" />
      <resx path="strings/InputMask.1036.resx" version="1.0.0" />
      <resx path="strings/InputMask.1031.resx" version="1.0.0" />
      <resx path="strings/InputMask.1041.resx" version="1.0.0" />
      <resx path="strings/InputMask.1033.resx" version="1.0.0" />
    </resources>

    <!--
      Uncomment only the features actually used. Each one becomes a permission
      prompt for the maker installing the control.

    <feature-usage>
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    -->
  </control>
</manifest>
